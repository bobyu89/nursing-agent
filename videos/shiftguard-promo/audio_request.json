  "lines": [
    { "id": "f01", "text": "離職單上，寫的是家庭因素。真相，藏在班表裡。" },
    { "id": "f02", "text": "缺班，靠人情調度。" },
    { "id": "f03", "text": "換班，靠感覺賭一把。" },
    { "id": "f04", "text": "連續上了幾天、夜班排得多密——沒有人真的算過。" },
    { "id": "f05", "text": "班守 ShiftGuard。" },
    { "id": "f06", "text": "把排班，從人情變成治理。" },
    { "id": "f07", "text": "護理師在 LINE 說一句話，系統聽懂。合格的替補前三名，直接送回來——不用再一個一個打電話。" },
    { "id": "f08", "text": "換班先預檢。違規的，當場擋下；放行的，附上法規依據。" },
    { "id": "f09", "text": "主任的儀表板：人力缺口、負荷，還有留任風險——一頁看完。" },
    { "id": "f10", "text": "最關鍵的一件事：AI，沒有計算工時的權限。" },
    { "id": "f11", "text": "數字歸規則引擎，勞基法十條硬規則內建，" },
    { "id": "f12", "text": "98 項自動測試把關。" },
    { "id": "f13", "text": "班表照顧好，人就留得住。" },
    { "id": "f14", "text": "班守 ShiftGuard，現在就能試。" }
  ],
  "bgm": { "mode": "none" }
}
